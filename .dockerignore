# ── Build artifacts ───────────────────────────────────────────
.next/
apps/cms/.next/
out/

# ── Dependencies (rebuilt inside Docker) ─────────────────────
node_modules/
apps/*/node_modules/
packages/*/node_modules/

# ── Dev / local environment ───────────────────────────────────
.env
.env.*
!.env.example
# VERIF-DOCKER-02: .env de CUALQUIER subdirectorio (p. ej. apps/cms/.env con secretos de dev) tampoco entra al contexto
**/.env
**/.env.*
!**/.env.example
infrastructure/docker/.env
infrastructure/docker/.env.prod

# ── Git / IDE / OS ────────────────────────────────────────────
.git/
.gitignore
.claude/
.atl/
.vscode/
.idea/
*.log
*.DS_Store
Thumbs.db

# ── Tests & coverage ──────────────────────────────────────────
coverage/
__tests__/
*.test.ts
*.spec.ts
playwright-report/

# ── CI / docs ─────────────────────────────────────────────────
.github/
*.md
!README.md

# ── Backups / temp ────────────────────────────────────────────
backups/
scratch/

# DEP-01: dumps de BD (posible PII) fuera del contexto de build
setup/*.dump
setup/*.dump.gz

# MIG-IMG fase 1: archivos subidos en desarrollo; nunca deben entrar al contexto ni a las capas de la imagen.
apps/cms/media
