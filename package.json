{
  "name": "unc-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit --project tsconfig.portal.json",
    "test": "vitest run --config vitest.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:int && npm run test:e2e",
    "infra:up": "docker compose -f infrastructure/docker/compose.yaml up -d",
    "infra:status": "docker compose -f infrastructure/docker/compose.yaml ps",
    "dev:portal": "next dev -p 3000",
    "dev:cms": "npm run dev --workspace=@unc/cms",
    "dev:apps": "concurrently -n PORTAL,CMS \"npm run dev:portal\" \"npm run dev:cms\"",
    "dev:all": "npm run infra:up && npm run dev:apps",
    "build:portal": "next build",
    "build:cms": "npm run build --workspace=@unc/cms",
    "build:all": "npm run build:cms && npm run build:portal",
    "sync:types": "node scripts/sync-types.js",
    "backup": "bash scripts/backup/backup.sh",
    "backup:named": "bash scripts/backup/backup.sh $1",
    "backup:restore": "bash scripts/backup/restore.sh $1",
    "backup:list": "ls -lh ./backups/ 2>/dev/null || echo 'No backups found'",
    "seed:convenios": "node scripts/seed-convenios.mjs",
    "seed:tribunal": "node scripts/seed-tribunal.mjs",
    "seed:odontologia": "node scripts/seed-odontologia.mjs",
    "seed:medicina": "node scripts/seed-medicina.mjs",
    "seed:agrarias": "node scripts/seed-agrarias.mjs",
    "seed:faqs": "node scripts/seed-faqs.mjs"
  },
  "dependencies": {
    "@unc/cms-types": "*",
    "next": "^16.2.12",
    "next-intl": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "eslint": "^8",
    "eslint-config-next": "^15.4.11",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "postcss": "^8.5.26",
    "fast-uri": "^4.1.2",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^1.1.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.12": true
  }
}
