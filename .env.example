# ============================================================
# Portal UNC — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# --- Portal (Next.js) ---
# NEXT_PUBLIC_CMS_URL = ORIGEN PÚBLICO donde se sirve /api/media/file/** (NO es la URL del panel del CMS).
#   Local: http://localhost:3002 (el CMS directo).  Producción: https://www.unc.edu.py (nginx hace proxy al CMS).
#   Las llamadas internas del portal al CMS usan CMS_URL (http://cms:3000 en Docker), no esta variable.
NEXT_PUBLIC_CMS_URL=http://localhost:3002
# Producción: https://www.unc.edu.py (único certificado del VPS; el panel del CMS queda en cms.unc.edu.py).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
REVALIDATION_SECRET=change-this-secret-min-32-chars
# Solo con almacén S3: host público de los objetos (producción: www.unc.edu.py; se sirven en /archivos/**).
MEDIA_HOSTNAME=

# --- CMS (Payload) ---
# See also apps/cms/.env.example
# Mínimo 32 caracteres, distinto de cualquier valor de ejemplo (firma sesiones y tokens). DEP-16: el CMS
# no arranca con un valor corto o de ejemplo. Genere uno con: openssl rand -hex 32
PAYLOAD_SECRET=change-this-payload-secret-min-32-chars
DATABASE_URI=postgresql://user:password@localhost:5432/unc_portal
NEXT_PUBLIC_SERVER_URL=http://localhost:3002

# --- Almacenamiento S3 (SeaweedFS; opcional en local: por defecto se usa disco) ---
# Solo lo lee el CMS cuando MEDIA_STORAGE=s3 (ver apps/cms/.env.example, donde está documentado).
# Claves: openssl rand -hex 10 (S3_ACCESS_KEY_ID) y openssl rand -hex 32 (S3_SECRET_ACCESS_KEY). Nunca valores reales aquí.
S3_BUCKET=unc-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1

# --- Email (optional for local dev — use Mailpit on port 1025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
# DEP-10: nombres canónicos (mismos que el CMS). SMTP_PASS y SMTP_FROM ya no se leen.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@unc.edu.py

# --- Sentry (error monitoring) ---
# Create a project at sentry.io, then copy the DSN from Settings → Client Keys.
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (safe — it's a public key).
NEXT_PUBLIC_SENTRY_DSN=
# The three below are build-time only (source map upload in CI). Never exposed to browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
