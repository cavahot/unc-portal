# ============================================================
# Portal UNC — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets.
# ============================================================

# --- Portal (Next.js) ---
NEXT_PUBLIC_CMS_URL=http://localhost:3002
REVALIDATION_SECRET=change-this-secret-min-32-chars
MEDIA_HOSTNAME=

# --- CMS (Payload) ---
# See also apps/cms/.env.example
PAYLOAD_SECRET=change-this-payload-secret-min-32-chars
DATABASE_URI=postgresql://user:password@localhost:5432/unc_portal
NEXT_PUBLIC_SERVER_URL=http://localhost:3002

# --- S3 / MinIO (optional for local dev — uses local storage by default) ---
S3_BUCKET=unc-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1

# --- Email (optional for local dev — use Mailpit on port 1025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@unc.edu.py

# --- Sentry (error monitoring) ---
# Create a project at sentry.io, then copy the DSN from Settings → Client Keys.
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (safe — it's a public key).
NEXT_PUBLIC_SENTRY_DSN=
# The three below are build-time only (source map upload in CI). Never exposed to browser.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
