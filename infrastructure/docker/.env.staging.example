# ============================================================
# Portal UNC — Variables de STAGING con datos sintéticos
# ============================================================
# Copiar a .env.staging (está en .gitignore) y reemplazar cada REEMPLAZAR_*.
# REGLA: ningún valor se copia de .env.prod. Cada secreto se genera nuevo (openssl rand -hex 32).
# Nunca poner datos reales de personas en esta base.
# ============================================================

# ── PostgreSQL propio de staging ─────────────────────────────
POSTGRES_DB=unc_portal_staging
POSTGRES_USER=unc_cms_staging
POSTGRES_PASSWORD=REEMPLAZAR_SECRETO_ALFANUMERICO_STAGING
# Formato: postgresql://USUARIO:CONTRASEÑA@postgres:5432/BASE (misma contraseña de arriba, sin caracteres reservados).
DATABASE_URI=postgresql://unc_cms_staging:REEMPLAZAR_SECRETO_ALFANUMERICO_STAGING@postgres:5432/unc_portal_staging

# ── Secretos propios de staging (mín. 32 caracteres, distintos de producción) ──
PAYLOAD_SECRET=REEMPLAZAR_SECRETO_PAYLOAD_STAGING
PREVIEW_SECRET=REEMPLAZAR_SECRETO_PREVIEW_STAGING
REVALIDATION_SECRET=REEMPLAZAR_SECRETO_REVALIDACION_STAGING

# ── URLs: solo loopback, se entra por túnel SSH (ssh -L 3100:127.0.0.1:3100 -L 3102:127.0.0.1:3102 usuario@servidor) ──
PORTAL_PUBLIC_URL=http://localhost:3100
CMS_PUBLIC_URL=http://localhost:3102
MEDIA_PUBLIC_ORIGIN=http://localhost:3100
MEDIA_HOSTNAME=localhost

# ── Medios ───────────────────────────────────────────────────
MEDIA_MAX_BYTES=10485760

# ── Contacto y correo: sin destinatarios reales ──────────────
CONTACT_TO=staging-sin-destino@example.test
# SMTP_* queda vacío a propósito: staging no envía correo.
