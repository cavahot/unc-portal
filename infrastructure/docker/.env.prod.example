# ============================================================
# Portal UNC — Production Environment Variables
# ============================================================
# Copy to .env.prod and fill every value before first deploy.
# NEVER commit .env.prod — it is listed in .gitignore.
# Rotate all secrets immediately if any are exposed.
#
# DEP-10: este archivo tiene UN nombre por concepto. Cada variable se
# interpola en compose.prod.yaml (o es de build-time, ver Sentry) y la lee
# el código del servicio indicado. La tabla por servicio está en DEPLOY.md.
# Los valores REEMPLAZAR_* son placeholders: nunca guardar secretos reales aquí.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=unc_portal
POSTGRES_USER=unc_cms
POSTGRES_PASSWORD=REEMPLAZAR_SECRETO_LARGO_ALEATORIO
# URI completa usada por el CMS (único nombre válido: DATABASE_URI). No colocarla en el Compose
# ni en el repositorio real. Formato: postgresql://USUARIO:CONTRASEÑA@postgres:5432/BASE
# - USUARIO y BASE deben coincidir con POSTGRES_USER y POSTGRES_DB.
# - CONTRASEÑA debe ser EXACTAMENTE la de POSTGRES_PASSWORD; si contiene caracteres reservados
#   hay que aplicar percent-encoding en la URI (@ → %40, : → %3A, / → %2F, # → %23, ? → %3F, % → %25).
#   Con una contraseña alfanumérica (ver DEPLOY.md) no hace falta codificar nada.
DATABASE_URI=postgresql://unc_cms:REEMPLAZAR_SECRETO_LARGO_ALEATORIO@postgres:5432/unc_portal
# Set to "true" only when using an external managed DB with TLS (e.g. AWS RDS).
# Leave as "false" for Docker Compose — internal network needs no SSL.
POSTGRES_SSL=false

# ── Almacén S3 (SeaweedFS) ───────────────────────────────────
# MIN-01 / S3-SEAWEEDFS-01: el almacén S3 es OPCIONAL (perfil de Compose `s3`; sustituye a MinIO). Con
# MEDIA_STORAGE=local (por defecto) estas variables pueden quedar vacías y `docker compose up` no arranca el
# servicio. Para usarlo: MEDIA_STORAGE=s3 y `docker compose --profile s3 up -d s3`.
# Las claves las lee el entrypoint del contenedor y también el CMS. El contenedor se niega a arrancar si el
# access key tiene < 16 o el secret < 32 caracteres (solo A-Z a-z 0-9 + / = _ . -). Generar con:
#   openssl rand -hex 16   (S3_ACCESS_KEY_ID)      openssl rand -hex 32   (S3_SECRET_ACCESS_KEY)
S3_ACCESS_KEY_ID=REEMPLAZAR_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REEMPLAZAR_SECRET_KEY_LARGO
# Bucket that CMS uploads media to (must exist: node scripts/s3/setup-bucket.mjs on first deploy)
S3_BUCKET=unc-media
# 1 = lectura anónima (GET) de objetos del bucket, necesaria para servir /archivos/ sin firmar. El listado, la
# subida y el borrado anónimos siguen denegados. 0 (por defecto) = ningún acceso anónimo.
S3_PUBLIC_READ=0
# Public-facing URL for media files (what browsers load).
# DOMINIOS-SSL-01: ya no hay host «files»; nginx publica los objetos en la ruta /archivos/ del host www
# (→ s3, solo con MEDIA_STORAGE=s3). Sin barra final.
S3_PUBLIC_URL=https://www.unc.edu.py/archivos

# ── Almacenamiento de media (MIG-IMG fase 1) ─────────────────
# `local` (por defecto): los archivos van al volumen persistente cms_media (/app/media en el CMS).
# `s3`: usa el almacén S3 (SeaweedFS) con las variables S3_*; debe elegirse de forma EXPLÍCITA (tener las claves ya
# no activa S3). Un despliegue que dependía de S3 sin este selector debe fijar MEDIA_STORAGE=s3.
MEDIA_STORAGE=local
# Tope por archivo subido, en bytes (10485760 = 10 MiB). Los archivos mayores se rechazan con 413, no se truncan.
MEDIA_MAX_BYTES=10485760

# ── Payload CMS ──────────────────────────────────────────────
# At least 32 random chars — used to sign cookies and API tokens. DEP-16: el CMS no arranca con un valor
# corto o de ejemplo. Genere uno con: openssl rand -hex 32
PAYLOAD_SECRET=REEMPLAZAR_SECRETO_PAYLOAD_LARGO
# Secreto (mín. 32 caracteres, `openssl rand -hex 32`) con el que el CMS firma los tokens de preview de 5 min
# (/api/preview?token=...) y el portal los verifica. Mismo valor para portal y CMS. DEP-16: nunca viaja en la URL.
PREVIEW_SECRET=REEMPLAZAR_SECRETO_PREVIEW
# Webhook opcional (n8n) para notificaciones editoriales. Vacío = desactivado.
N8N_WEBHOOK_URL=

# ── Public URLs ───────────────────────────────────────────────
# Fuente única de las URL públicas. El compose las proyecta a los nombres que lee cada código:
#   CMS_PUBLIC_URL     → NEXT_PUBLIC_SERVER_URL (SOLO el CMS)
#   PORTAL_PUBLIC_URL  → PORTAL_URL (CMS) y NEXT_PUBLIC_SITE_URL (portal)
#   MEDIA_PUBLIC_ORIGIN→ NEXT_PUBLIC_CMS_URL (portal): origen donde se sirve /api/media/file/** (obligatoria)
# DOMINIOS-SSL-01: el portal vive en www (certificado Sectigo único); el panel del CMS en cms (Let's Encrypt).
PORTAL_PUBLIC_URL=https://www.unc.edu.py
CMS_PUBLIC_URL=https://cms.unc.edu.py
# Origen público de la media: el mismo host www (nginx reenvía solo /api/media/file/ al CMS, GET/HEAD).
MEDIA_PUBLIC_ORIGIN=https://www.unc.edu.py
# Host de las imágenes para next/image y la CSP (solo relevante con S3: los objetos salen de /archivos/ en www).
MEDIA_HOSTNAME=www.unc.edu.py

# ── Revalidation ─────────────────────────────────────────────
# Bearer token que el CMS envía a /api/revalidate del portal. Mismo valor para portal y CMS.
# DEP-16: mín. 32 caracteres, no de ejemplo; si es débil el portal responde 503 a /api/revalidate.
REVALIDATION_SECRET=REEMPLAZAR_SECRETO_REVALIDACION

# ── Email (production SMTP) ───────────────────────────────────
# Los lee el CMS (recuperación de contraseña) y el portal (formulario de contacto).
SMTP_HOST=smtp.unc.edu.py
SMTP_PORT=587
# "true" = TLS implícito (típico en el puerto 465); "false" = STARTTLS/sin TLS (puerto 587).
SMTP_SECURE=false
# Si el relay exige autenticación, completar ambos; si no la exige, dejar ambos vacíos.
SMTP_USER=REEMPLAZAR_USUARIO_SMTP
SMTP_PASSWORD=REEMPLAZAR_PASSWORD_SMTP
SMTP_FROM_ADDRESS=noreply@unc.edu.py
SMTP_FROM_NAME=Portal Institucional UNC
# Destino de los mensajes del formulario de contacto (solo portal).
CONTACT_TO=secgral@unc.edu.py

# ── Sentry ───────────────────────────────────────────────────
# DSN is safe to expose (lo lee el portal en runtime); ORG/PROJECT/AUTH_TOKEN son solo de build:
# los consume next.config.mjs y deploy.yml los pasa como build-args desde secrets de GitHub.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/YYYY
SENTRY_ORG=unc
SENTRY_PROJECT=portal-unc
# Create at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=REEMPLAZAR_TOKEN_SENTRY

# ── Respaldos (BACKUP-MEDIA-01) ──────────────────────────────
# Estas variables las leen los scripts de scripts/backup/ desde /opt/unc-portal/.env.backup (modo 600), NO este archivo;
# se listan aquí solo como referencia. No poner valores reales en el repositorio.
# Frase de paso (>= 20 caracteres) con la que se cifran la BD y la media. Sin ella los respaldos son ilegibles: guardarla fuera del servidor.
# BACKUP_ENCRYPTION_PASSPHRASE=
# Directorio local de respaldos (por defecto /opt/unc-portal/backups; puede ser otro montaje).
# BACKUP_LOCAL_DIR=
# Días de retención de los respaldos locales cifrados (por defecto 14).
# BACKUP_RETENTION_DAYS=
# Copia EXTERNA (vacío = no configurada). Formas: remoto-rclone:ruta | ssh://usuario@host[:puerto]/ruta | usuario@host:/ruta.
# No editar a mano: ejecutar scripts/backup/configure-offsite.sh (prueba la conexión antes de guardar).
# BACKUP_REMOTE=
# Ruta absoluta de la llave privada SSH dedicada a respaldos (solo para destinos SSH; opcional).
# BACKUP_SSH_KEY=
# Imagen local con tar para respaldar la media cuando el CMS está caído (opcional; nunca se descarga durante un deploy).
# BACKUP_MEDIA_IMAGE=
