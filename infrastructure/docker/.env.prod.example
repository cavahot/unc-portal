# ============================================================
# Portal UNC — Production Environment Variables
# ============================================================
# Copy to .env.prod and fill every value before first deploy.
# NEVER commit .env.prod — it is listed in .gitignore.
# Rotate all secrets immediately if any are exposed.
#
# DEP-10: este archivo tiene UN nombre por concepto. Cada variable se
# interpola en compose.prod.yaml (o es de build-time, ver Sentry) y la lee
# el código del servicio indicado. La tabla por servicio está en DEPLOY.md.
# Los valores REEMPLAZAR_* son placeholders: nunca guardar secretos reales aquí.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=unc_portal
POSTGRES_USER=unc_cms
POSTGRES_PASSWORD=REEMPLAZAR_SECRETO_LARGO_ALEATORIO
# URI completa usada por el CMS (único nombre válido: DATABASE_URI). No colocarla en el Compose
# ni en el repositorio real. Formato: postgresql://USUARIO:CONTRASEÑA@postgres:5432/BASE
# - USUARIO y BASE deben coincidir con POSTGRES_USER y POSTGRES_DB.
# - CONTRASEÑA debe ser EXACTAMENTE la de POSTGRES_PASSWORD; si contiene caracteres reservados
#   hay que aplicar percent-encoding en la URI (@ → %40, : → %3A, / → %2F, # → %23, ? → %3F, % → %25).
#   Con una contraseña alfanumérica (ver DEPLOY.md) no hace falta codificar nada.
DATABASE_URI=postgresql://unc_cms:REEMPLAZAR_SECRETO_LARGO_ALEATORIO@postgres:5432/unc_portal
# Set to "true" only when using an external managed DB with TLS (e.g. AWS RDS).
# Leave as "false" for Docker Compose — internal network needs no SSL.
POSTGRES_SSL=false

# ── MinIO S3 ─────────────────────────────────────────────────
MINIO_ROOT_USER=REEMPLAZAR_ACCESS_KEY
MINIO_ROOT_PASSWORD=REEMPLAZAR_SECRET_KEY_LARGO
# Bucket that CMS uploads media to (must exist, create on first deploy)
S3_BUCKET=unc-media
# Public-facing URL for media files (what browsers load).
# In production: the files. subdomain served through nginx → minio.
S3_PUBLIC_URL=https://files.unc.edu.py

# ── Payload CMS ──────────────────────────────────────────────
# At least 32 random chars — used to sign cookies and API tokens. DEP-16: el CMS no arranca con un valor
# corto o de ejemplo. Genere uno con: openssl rand -hex 32
PAYLOAD_SECRET=REEMPLAZAR_SECRETO_PAYLOAD_LARGO
# Secreto (mín. 32 caracteres, `openssl rand -hex 32`) con el que el CMS firma los tokens de preview de 5 min
# (/api/preview?token=...) y el portal los verifica. Mismo valor para portal y CMS. DEP-16: nunca viaja en la URL.
PREVIEW_SECRET=REEMPLAZAR_SECRETO_PREVIEW
# Webhook opcional (n8n) para notificaciones editoriales. Vacío = desactivado.
N8N_WEBHOOK_URL=

# ── Public URLs ───────────────────────────────────────────────
# Fuente única de las URL públicas. El compose las proyecta a los nombres que lee cada código:
#   CMS_PUBLIC_URL    → NEXT_PUBLIC_SERVER_URL (CMS) y NEXT_PUBLIC_CMS_URL (portal)
#   PORTAL_PUBLIC_URL → PORTAL_URL (CMS) y NEXT_PUBLIC_SITE_URL (portal)
PORTAL_PUBLIC_URL=https://portal.unc.edu.py
CMS_PUBLIC_URL=https://cms.unc.edu.py
MEDIA_HOSTNAME=files.unc.edu.py

# ── Revalidation ─────────────────────────────────────────────
# Bearer token que el CMS envía a /api/revalidate del portal. Mismo valor para portal y CMS.
# DEP-16: mín. 32 caracteres, no de ejemplo; si es débil el portal responde 503 a /api/revalidate.
REVALIDATION_SECRET=REEMPLAZAR_SECRETO_REVALIDACION

# ── Email (production SMTP) ───────────────────────────────────
# Los lee el CMS (recuperación de contraseña) y el portal (formulario de contacto).
SMTP_HOST=smtp.unc.edu.py
SMTP_PORT=587
# "true" = TLS implícito (típico en el puerto 465); "false" = STARTTLS/sin TLS (puerto 587).
SMTP_SECURE=false
# Si el relay exige autenticación, completar ambos; si no la exige, dejar ambos vacíos.
SMTP_USER=REEMPLAZAR_USUARIO_SMTP
SMTP_PASSWORD=REEMPLAZAR_PASSWORD_SMTP
SMTP_FROM_ADDRESS=noreply@unc.edu.py
SMTP_FROM_NAME=Portal Institucional UNC
# Destino de los mensajes del formulario de contacto (solo portal).
CONTACT_TO=secgral@unc.edu.py

# ── Sentry ───────────────────────────────────────────────────
# DSN is safe to expose (lo lee el portal en runtime); ORG/PROJECT/AUTH_TOKEN son solo de build:
# los consume next.config.mjs y deploy.yml los pasa como build-args desde secrets de GitHub.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/YYYY
SENTRY_ORG=unc
SENTRY_PROJECT=portal-unc
# Create at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=REEMPLAZAR_TOKEN_SENTRY
