POSTGRES_DB=unc_portal
POSTGRES_USER=unc_cms
POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_LOCAL

# S3-SEAWEEDFS-01: almacén S3 local (servicio `s3`). Sin estas claves el contenedor no arranca (falla cerrado).
# Mín. 16 / 32 caracteres; generar con: openssl rand -hex 16  /  openssl rand -hex 32. Sustituyen a MINIO_ROOT_*.
S3_ACCESS_KEY_ID=REEMPLAZAR_CON_ACCESS_KEY_LOCAL
S3_SECRET_ACCESS_KEY=REEMPLAZAR_CON_SECRET_KEY_LOCAL_LARGA
S3_BUCKET=unc-media
# 1 = GET anónimo de objetos del bucket (solo si lo necesita en desarrollo); 0 = cerrado
S3_PUBLIC_READ=0
