{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "next-intl.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "i18n/**/*.ts",
    "i18n/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "types/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "packages",
    "scripts"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    }
  }
}
