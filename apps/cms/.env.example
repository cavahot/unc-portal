# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://user:password@localhost:5432/unc_portal

# ── Payload CMS ───────────────────────────────────────────────────────────────
PAYLOAD_SECRET=changeme-use-a-random-string-here
NEXT_PUBLIC_SERVER_URL=http://localhost:3002

# ── Email (Mailpit para dev local) ────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@unc.edu.py
SMTP_FROM_NAME=Portal UNC

# ── URLs ──────────────────────────────────────────────────────────────────────
# DEP-10: PORTAL_URL es la única URL del portal que lee el CMS (NEXT_PUBLIC_SERVER_URL es la del propio CMS).
PORTAL_URL=http://localhost:3000

# ── Preview y revalidación ────────────────────────────────────────────────────
PREVIEW_SECRET=changeme-preview-secret
REVALIDATION_SECRET=changeme-revalidation-secret

# ── N8N (opcional) ────────────────────────────────────────────────────────────
# Dejar vacío para deshabilitar notificaciones por webhook
N8N_WEBHOOK_URL=

# ── S3 / MinIO (opcional) ─────────────────────────────────────────────────────
# Sin estas variables, Payload guarda archivos localmente (apto para dev)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=unc-media
S3_REGION=us-east-1
# Public URL for serving media files via Next.js Image:
#   Local:      http://127.0.0.1:9100  (MinIO path-style)
#   Production: https://files.unc.edu.py  (CDN o MinIO público)
S3_PUBLIC_URL=http://127.0.0.1:9100

# ── Contacto ──────────────────────────────────────────────────────────────────
CONTACT_TO=contacto@unc.edu.py

# ── Seed (SEC-08) ─────────────────────────────────────────────────────────────
# Obligatoria para sembrar el superadmin (npm run seed:*): mínimo 12 caracteres, no un valor
# conocido. Sin ella el seed falla antes de escribir. NUNCA definirla ni sembrar en producción.
SEED_ADMIN_PASSWORD=
