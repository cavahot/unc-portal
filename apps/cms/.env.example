# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://user:password@localhost:5432/unc_portal

# ── Payload CMS ───────────────────────────────────────────────────────────────
# Mínimo 32 caracteres, distinto de cualquier valor de ejemplo (firma sesiones y tokens). DEP-16: el CMS
# no arranca con un valor corto o de ejemplo. Genere uno con: openssl rand -hex 32
PAYLOAD_SECRET=changeme-use-a-random-string-here
NEXT_PUBLIC_SERVER_URL=http://localhost:3002

# ── Email (Mailpit para dev local) ────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@unc.edu.py
SMTP_FROM_NAME=Portal UNC

# ── URLs ──────────────────────────────────────────────────────────────────────
# DEP-10: PORTAL_URL es la única URL del portal que lee el CMS (NEXT_PUBLIC_SERVER_URL es la del propio CMS).
# DEP-19b: el CMS avisa a este origen en POST /api/revalidate al guardar contenido. El PUERTO debe ser el del portal
# (npm run dev:portal escucha en 3000). Si apunta a un puerto sin servicio el log dice «ECONNREFUSED -> host:puerto».
# REVALIDATION_SECRET (más abajo) debe ser IDÉNTICO al del portal (.env.development.local); si no, el portal responde 401.
PORTAL_URL=http://localhost:3000

# ── Preview y revalidación ────────────────────────────────────────────────────
PREVIEW_SECRET=changeme-preview-secret
REVALIDATION_SECRET=changeme-revalidation-secret

# ── N8N (opcional) ────────────────────────────────────────────────────────────
# Dejar vacío para deshabilitar notificaciones por webhook
N8N_WEBHOOK_URL=

# ── Almacenamiento de media (MIG-IMG fase 1) ──────────────────────────────────
# MEDIA_STORAGE=local (por defecto): archivos en el directorio MEDIA_DIR (en dev `media`, ignorado por git).
# MEDIA_STORAGE=s3: usa el almacén S3 (SeaweedFS) con las variables S3_* de abajo; debe elegirse de forma EXPLÍCITA
# (tener S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY ya NO activa S3). Si falta alguna variable S3_*, el CMS no arranca.
MEDIA_STORAGE=local
# MEDIA_DIR=media
# Tope por archivo en bytes (por defecto 10485760 = 10 MiB); mayores -> 413, nunca truncados.
# MEDIA_MAX_BYTES=10485760

# ── Almacén S3 / SeaweedFS (solo si MEDIA_STORAGE=s3) ─────────────────────────
# Generar las claves (nunca commitear valores reales):
#   S3_ACCESS_KEY_ID:     openssl rand -hex 10
#   S3_SECRET_ACCESS_KEY: openssl rand -hex 32
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint interno que usa el CMS para subir (path-style). Su sonda de salud es <S3_ENDPOINT>/healthz.
S3_ENDPOINT=http://127.0.0.1:9100
S3_BUCKET=unc-media
S3_REGION=us-east-1
# URL pública para servir los archivos (la guarda la BD y la consume el portal):
#   Local:      http://127.0.0.1:9100  (SeaweedFS path-style)
#   Producción: https://files.unc.edu.py  (nginx, solo GET, delante del almacén S3)
S3_PUBLIC_URL=http://127.0.0.1:9100

# ── Contacto ──────────────────────────────────────────────────────────────────
CONTACT_TO=contacto@unc.edu.py

# ── Seed (SEC-08) ─────────────────────────────────────────────────────────────
# Obligatoria para sembrar el superadmin (npm run seed:*): mínimo 12 caracteres, no un valor
# conocido. Sin ella el seed falla antes de escribir. NUNCA definirla ni sembrar en producción.
SEED_ADMIN_PASSWORD=
