# ── Base ──────────────────────────────────────────────────────────────────────
DATABASE_URI=postgresql://user:pass@127.0.0.1:5433/unc_portal
PAYLOAD_SECRET=your-random-secret-here
NEXT_PUBLIC_SERVER_URL=http://localhost:3002
PORTAL_URL=http://localhost:3000
PREVIEW_SECRET=your-preview-secret-here

# ── Email (Mailpit for local dev) ─────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_ADDRESS=portal@unc.edu.py
SMTP_FROM_NAME="Portal Institucional UNC"

# ── Storage — MinIO S3 ────────────────────────────────────────────────────────
S3_BUCKET=unc-media
S3_ACCESS_KEY_ID=your-minio-access-key
S3_SECRET_ACCESS_KEY=your-minio-secret-key
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
# Public URL for serving media files via Next.js Image:
#   Local:      http://127.0.0.1:9100  (MinIO path-style)
#   Production: https://files.unc.edu.py  (public MinIO or CDN)
S3_PUBLIC_URL=http://127.0.0.1:9100
