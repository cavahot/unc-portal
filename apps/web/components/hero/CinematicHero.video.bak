'use client';

import Link from 'next/link';
import {
  useCallback,
  useEffect,
  useRef,
  useState,
} from 'react';

/* =========================================================
   UTILIDADES
   ========================================================= */

function clamp(
  value: number,
  minimum = 0,
  maximum = 1,
) {
  return Math.min(
    maximum,
    Math.max(minimum, value),
  );
}

function smoothstep(
  start: number,
  end: number,
  value: number,
) {
  const progress = clamp(
    (value - start) / (end - start),
  );

  return (
    progress *
    progress *
    (3 - 2 * progress)
  );
}

function ArrowIcon() {
  return (
    <svg
      aria-hidden="true"
      className="h-4 w-4"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        strokeLinecap="round"
        strokeLinejoin="round"
        strokeWidth={2}
        d="M5 12h14m-6-6 6 6-6 6"
      />
    </svg>
  );
}

/* =========================================================
   HERO CINEMATOGRÁFICO
   ========================================================= */

export default function CinematicHero() {
  const sectionRef =
    useRef<HTMLElement>(null);

  const videoRef =
    useRef<HTMLVideoElement>(null);

  const animationFrameRef =
    useRef<number | null>(null);

  const videoLoadedRef =
    useRef(false);

  const [scrollProgress, setScrollProgress] =
    useState(0);

  const [videoReady, setVideoReady] =
    useState(false);

  const [videoError, setVideoError] =
    useState(false);

  const [reducedMotion, setReducedMotion] =
    useState(false);

  /*
   * Velo que oculta el salto entre el último y
   * el primer fotograma del video.
   */
  const [loopVeilOpacity, setLoopVeilOpacity] =
    useState(0.82);

  /* =======================================================
     ACCESIBILIDAD
     ======================================================= */

  useEffect(() => {
    const mediaQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    );

    const updatePreference = () => {
      setReducedMotion(mediaQuery.matches);
    };

    updatePreference();

    mediaQuery.addEventListener(
      'change',
      updatePreference,
    );

    return () => {
      mediaQuery.removeEventListener(
        'change',
        updatePreference,
      );
    };
  }, []);

  /* =======================================================
     PROGRESO DEL DESPLAZAMIENTO
     ======================================================= */

  const updateScrollProgress =
    useCallback(() => {
      const section = sectionRef.current;

      if (!section) {
        return;
      }

      const rect =
        section.getBoundingClientRect();

      const availableScroll =
        section.offsetHeight -
        window.innerHeight;

      if (availableScroll <= 0) {
        setScrollProgress(0);
        return;
      }

      const travelledDistance =
        Math.max(0, -rect.top);

      const progress = clamp(
        travelledDistance / availableScroll,
      );

      setScrollProgress(progress);
    }, []);

  useEffect(() => {
    const handleViewportChange = () => {
      if (
        animationFrameRef.current !== null
      ) {
        return;
      }

      animationFrameRef.current =
        window.requestAnimationFrame(() => {
          updateScrollProgress();

          animationFrameRef.current =
            null;
        });
    };

    updateScrollProgress();

    window.addEventListener(
      'scroll',
      handleViewportChange,
      {
        passive: true,
      },
    );

    window.addEventListener(
      'resize',
      handleViewportChange,
    );

    return () => {
      window.removeEventListener(
        'scroll',
        handleViewportChange,
      );

      window.removeEventListener(
        'resize',
        handleViewportChange,
      );

      if (
        animationFrameRef.current !== null
      ) {
        window.cancelAnimationFrame(
          animationFrameRef.current,
        );
      }
    };
  }, [updateScrollProgress]);

  /* =======================================================
     REPRODUCCIÓN SEGÚN VISIBILIDAD
     ======================================================= */

  useEffect(() => {
    const section = sectionRef.current;
    const video = videoRef.current;

    if (!section || !video) {
      return;
    }

    const observer =
      new IntersectionObserver(
        ([entry]) => {
          if (reducedMotion) {
            video.pause();

            try {
              video.currentTime = 0;
            } catch {
              // El navegador todavía no cargó los metadatos.
            }

            return;
          }

          if (entry.isIntersecting) {
            const playPromise =
              video.play();

            if (playPromise !== undefined) {
              playPromise.catch((error) => {
                console.warn(
                  'El navegador no inició automáticamente el video:',
                  error,
                );
              });
            }
          } else {
            video.pause();
          }
        },
        {
          threshold: 0.12,
          rootMargin: '80px 0px 80px 0px',
        },
      );

    observer.observe(section);

    return () => {
      observer.disconnect();
      video.pause();
    };
  }, [reducedMotion]);

  /* =======================================================
     EVENTOS DEL VIDEO
     ======================================================= */

  const handleVideoLoaded =
    useCallback(() => {
      const video = videoRef.current;

      if (!video) {
        return;
      }

      video.muted = true;
      video.playbackRate = 0.78;

      if (!videoLoadedRef.current) {
        videoLoadedRef.current = true;

        setVideoReady(true);
        setVideoError(false);
      }

      if (!reducedMotion) {
        const playPromise = video.play();

        if (playPromise !== undefined) {
          playPromise.catch(() => {
            /*
             * El IntersectionObserver volverá a
             * intentar iniciar la reproducción.
             */
          });
        }
      }
    }, [reducedMotion]);

  const handleVideoError =
    useCallback(() => {
      videoLoadedRef.current = false;

      setVideoReady(false);
      setVideoError(true);

      console.error(
        'No se pudo cargar el archivo:',
        '/videos/campus-entrada-scroll.mp4',
      );
    }, []);

  /* =======================================================
     SUAVIZADO DEL LOOP

     Al aproximarse al final, aparece un velo verde.
     El velo permanece al reiniciarse el video y luego
     desaparece progresivamente.
     ======================================================= */

  const handleVideoTimeUpdate =
    useCallback(() => {
      const video = videoRef.current;

      if (
        !video ||
        !Number.isFinite(video.duration) ||
        video.duration <= 0
      ) {
        return;
      }

      const duration = video.duration;
      const currentTime = video.currentTime;

      /*
       * Ventana del fundido del loop.
       * Se adapta automáticamente a la duración.
       */
      const fadeWindow = Math.max(
        0.32,
        Math.min(
          0.62,
          duration * 0.18,
        ),
      );

      const startFade = clamp(
        1 - currentTime / fadeWindow,
      );

      const endFade = clamp(
        (
          currentTime -
          (duration - fadeWindow)
        ) / fadeWindow,
      );

      /*
       * El final se cubre de verde y el comienzo
       * inicia con el mismo verde.
       */
      const requestedOpacity =
        Math.max(
          startFade,
          endFade,
        ) * 0.82;

      setLoopVeilOpacity(
        requestedOpacity,
      );
    }, []);

  /* =======================================================
     VALORES GENERALES DE ANIMACIÓN
     ======================================================= */

  const progress = reducedMotion
    ? 0
    : scrollProgress;

  const cameraProgress =
    smoothstep(0, 1, progress);

  const cameraScale =
    1.01 + cameraProgress * 0.13;

  const cameraTranslateY =
    cameraProgress * 17;

  /* =======================================================
     PANEL PRINCIPAL

     Desaparición más extensa y progresiva.
     ======================================================= */

  const contentFadeProgress =
    smoothstep(
      0.05,
      0.46,
      progress,
    );

  const contentOpacity =
    1 - contentFadeProgress;

  const contentTranslateY =
    smoothstep(
      0,
      0.52,
      progress,
    ) * -72;

  const contentScale =
    1 -
    smoothstep(
      0,
      0.5,
      progress,
    ) *
      0.06;

  /* =======================================================
     ETIQUETAS E INDICADOR
     ======================================================= */

  const labelsOpacity =
    1 -
    smoothstep(
      0.03,
      0.3,
      progress,
    );

  const indicatorOpacity =
    1 -
    smoothstep(
      0.01,
      0.2,
      progress,
    );

  /* =======================================================
     MENSAJE DE BIENVENIDA
     ======================================================= */

  const welcomeIn =
    smoothstep(
      0.34,
      0.54,
      progress,
    );

  const welcomeOut =
    1 -
    smoothstep(
      0.7,
      0.94,
      progress,
    );

  const welcomeOpacity =
    welcomeIn * welcomeOut;

  const welcomeScale =
    0.92 + welcomeIn * 0.08;

  const welcomeTranslateY =
    (1 - welcomeIn) * 24;

  /* =======================================================
     TRATAMIENTO CINEMATOGRÁFICO
     ======================================================= */

  const overlayOpacity =
    0.39 -
    smoothstep(
      0,
      0.78,
      progress,
    ) *
      0.14;

  const roadGlowOpacity =
    smoothstep(
      0.14,
      0.6,
      progress,
    ) *
    (
      1 -
      smoothstep(
        0.76,
        0.95,
        progress,
      )
    );

  /*
   * El video pierde intensidad lentamente antes
   * de que aparezcan las capas finales.
   */
  const videoSceneOpacity =
    1 -
    smoothstep(
      0.7,
      0.98,
      progress,
    ) *
      0.46;

  /*
   * Primera etapa: video hacia verde institucional.
   */
  const greenTransitionOpacity =
    smoothstep(
      0.72,
      0.95,
      progress,
    );

  /*
   * Segunda etapa: verde institucional hacia
   * la superficie clara de la sección siguiente.
   */
  const lightTransitionOpacity =
    smoothstep(
      0.88,
      1,
      progress,
    );

  return (
    <section
      ref={sectionRef}
      aria-label="Ingreso al campus de la Universidad Nacional de Concepción"
      className="relative h-[300svh] md:h-[350svh]"
    >
      <div className="sticky top-0 h-svh min-h-[640px] overflow-hidden bg-[#004700]">
        {/* =================================================
            VIDEO DE FONDO
            ================================================= */}

        <div
          className="absolute inset-0 will-change-transform"
          style={{
            opacity: videoSceneOpacity,

            transform: reducedMotion
              ? 'none'
              : `
                translate3d(
                  0,
                  ${cameraTranslateY}px,
                  0
                )
                scale(${cameraScale})
              `,

            transformOrigin: '50% 56%',
          }}
        >
          {/* Póster de respaldo */}

          <div
            aria-hidden="true"
            className="absolute inset-0 bg-cover bg-center"
            style={{
              backgroundImage:
                "url('/images/campus-entrada-poster.jpg')",
            }}
          />

          <video
            ref={videoRef}
            src="/videos/campus-entrada-scroll.mp4"
            muted
            autoPlay
            loop
            playsInline
            preload="auto"
            poster="/images/campus-entrada-poster.jpg"
            controls={false}
            disablePictureInPicture
            tabIndex={-1}
            aria-hidden="true"
            onLoadedData={handleVideoLoaded}
            onCanPlay={handleVideoLoaded}
            onTimeUpdate={
              handleVideoTimeUpdate
            }
            onSeeked={
              handleVideoTimeUpdate
            }
            onPlay={
              handleVideoTimeUpdate
            }
            onError={handleVideoError}
            className="pointer-events-none absolute inset-0 h-full w-full object-cover object-center transition-opacity duration-1000"
            style={{
              opacity:
                videoReady && !videoError
                  ? 1
                  : 0,
            }}
          />

          {/* Velo verde para ocultar el salto del loop */}

          <div
            aria-hidden="true"
            className="pointer-events-none absolute inset-0 bg-[#004700] transition-opacity duration-300 ease-out"
            style={{
              opacity:
                videoReady && !videoError
                  ? loopVeilOpacity
                  : 0,
            }}
          />

          {/* Estado de carga */}

          {!videoReady && !videoError && (
            <div className="absolute inset-x-0 bottom-10 flex justify-center px-4">
              <span className="rounded-full border border-white/30 bg-[#001A00]/60 px-4 py-2 text-[0.65rem] font-semibold uppercase tracking-[0.17em] text-white/85 backdrop-blur-md">
                Cargando recorrido del campus…
              </span>
            </div>
          )}

          {/* Respaldo cuando el video falla */}

          {videoError && (
            <div className="absolute inset-x-0 bottom-10 flex justify-center px-4">
              <span className="rounded-full border border-white/25 bg-[#001A00]/60 px-4 py-2 text-[0.65rem] font-semibold uppercase tracking-[0.17em] text-white/80 backdrop-blur-md">
                Vista institucional del campus
              </span>
            </div>
          )}
        </div>

        {/* =================================================
            CAPAS CINEMATOGRÁFICAS
            ================================================= */}

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 bg-[#001A00]"
          style={{
            opacity: overlayOpacity,
          }}
        />

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,rgba(0,26,0,0.20)_0%,rgba(0,26,0,0.02)_38%,rgba(0,26,0,0.08)_65%,rgba(0,26,0,0.72)_100%)]"
        />

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 shadow-[inset_0_0_180px_rgba(0,26,0,0.62)]"
        />

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_62%,rgba(138,255,138,0.25)_0%,rgba(0,163,0,0.09)_24%,transparent_52%)]"
          style={{
            opacity: roadGlowOpacity,
          }}
        />

        {/* =================================================
            ETIQUETAS
            ================================================= */}

        <div
          aria-hidden="true"
          className="absolute left-5 top-28 hidden items-center gap-3 rounded-full border border-white/30 bg-white/[0.13] px-4 py-2.5 text-xs font-semibold text-white shadow-lg backdrop-blur-sm lg:flex"
          style={{
            opacity: labelsOpacity,
          }}
        >
          <span className="h-2 w-2 rounded-full bg-[#5CFF5C] shadow-[0_0_18px_rgba(92,255,92,0.9)]" />

          Acceso principal
        </div>

        <div
          aria-hidden="true"
          className="absolute right-5 top-28 hidden rounded-full border border-white/30 bg-white/[0.13] px-4 py-2.5 text-xs font-semibold uppercase tracking-[0.18em] text-white shadow-lg backdrop-blur-sm lg:block"
          style={{
            opacity: labelsOpacity,
          }}
        >
          Concepción · Paraguay
        </div>

        {/* =================================================
            PANEL PRINCIPAL
            ================================================= */}

        <div
          className="relative z-10 flex h-full items-center justify-center px-4 pb-16 pt-28 sm:px-6 lg:px-8"
          style={{
            opacity: contentOpacity,

            transform: reducedMotion
              ? 'none'
              : `
                translate3d(
                  0,
                  ${contentTranslateY}px,
                  0
                )
                scale(${contentScale})
              `,
          }}
        >
          <div className="relative mx-auto w-full max-w-5xl overflow-hidden rounded-[2rem] border border-white/50 bg-white/[0.20] px-6 py-9 text-center shadow-[0_30px_80px_-28px_rgba(0,26,0,0.82)] backdrop-blur-md sm:px-10 sm:py-12 lg:px-16 lg:py-14">
            {/* Reflejo superior */}

            <div
              aria-hidden="true"
              className="pointer-events-none absolute inset-x-12 top-0 h-px bg-gradient-to-r from-transparent via-white to-transparent"
            />

            {/* Luz blanca interior */}

            <div
              aria-hidden="true"
              className="pointer-events-none absolute left-1/2 top-[-10rem] h-72 w-72 -translate-x-1/2 rounded-full bg-white/20 blur-3xl"
            />

            <div className="relative">
              <div className="mb-5 inline-flex items-center gap-2 rounded-full border border-white/50 bg-white/[0.18] px-4 py-2 shadow-sm">
                <span className="h-1.5 w-1.5 rounded-full bg-[#5CFF5C] shadow-[0_0_12px_rgba(92,255,92,0.9)]" />

                <span className="text-[0.68rem] font-bold uppercase tracking-[0.24em] text-white sm:text-xs">
                  Universidad Nacional de Concepción
                </span>
              </div>

              <h1 className="mx-auto max-w-4xl text-balance text-4xl font-black leading-[0.94] tracking-[-0.055em] text-white drop-shadow-[0_5px_20px_rgba(0,26,0,0.95)] sm:text-5xl md:text-6xl lg:text-[5.2rem]">
                Marcando el Norte,,,!!
              </h1>

              <p className="mx-auto mt-6 max-w-2xl text-base font-semibold leading-relaxed text-white drop-shadow-[0_3px_10px_rgba(0,26,0,0.9)] sm:text-lg">
                Formación académica, investigación,
                innovación y compromiso con el desarrollo
                sostenible del norte del Paraguay.
              </p>

              <div className="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
                <Link
                  href="/carreras"
                  className="pill-button pill-button-primary"
                >
                  Explorar carreras
                  <ArrowIcon />
                </Link>

                <Link
                  href="/institucional"
                  className="pill-button pill-button-secondary"
                >
                  Conocer la UNC
                </Link>
              </div>

              <div className="mx-auto mt-9 grid max-w-3xl grid-cols-3 divide-x divide-white/40 border-t border-white/40 pt-6">
                <div className="px-2">
                  <strong className="block text-lg font-black text-white drop-shadow-md sm:text-2xl">
                    1967
                  </strong>

                  <span className="mt-1 block text-[0.65rem] font-bold uppercase tracking-[0.13em] text-white/85 sm:text-xs">
                    Fundación
                  </span>
                </div>

                <div className="px-2">
                  <strong className="block text-lg font-black text-white drop-shadow-md sm:text-2xl">
                    UNC
                  </strong>

                  <span className="mt-1 block text-[0.65rem] font-bold uppercase tracking-[0.13em] text-white/85 sm:text-xs">
                    Universidad pública
                  </span>
                </div>

                <div className="px-2">
                  <strong className="block text-lg font-black text-white drop-shadow-md sm:text-2xl">
                    Norte
                  </strong>

                  <span className="mt-1 block text-[0.65rem] font-bold uppercase tracking-[0.13em] text-white/85 sm:text-xs">
                    Compromiso regional
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* =================================================
            MENSAJE DE BIENVENIDA
            ================================================= */}

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-x-0 top-1/2 z-20 flex justify-center px-4"
          style={{
            opacity: welcomeOpacity,

            transform: `
              translate3d(
                0,
                ${welcomeTranslateY}px,
                0
              )
              scale(${welcomeScale})
            `,
          }}
        >
          <div className="rounded-[2rem] border border-white/50 bg-white/[0.20] px-7 py-5 text-center shadow-[0_28px_70px_-26px_rgba(0,26,0,0.95)] backdrop-blur-md sm:px-11 sm:py-6">
            <span className="block text-[0.64rem] font-bold uppercase tracking-[0.3em] text-[#E6FFE6]">
              Atravesando el acceso principal
            </span>

            <strong className="mt-2 block text-xl font-black text-white drop-shadow-md sm:text-3xl">
              Bienvenidos al campus UNC
            </strong>
          </div>
        </div>

        {/* =================================================
            INDICADOR
            ================================================= */}

        <div
          className="absolute bottom-7 left-1/2 z-20 flex -translate-x-1/2 flex-col items-center gap-2"
          style={{
            opacity: indicatorOpacity,
          }}
        >
          <span className="whitespace-nowrap text-[0.62rem] font-bold uppercase tracking-[0.22em] text-white/85">
            Desplázate para ingresar
          </span>

          <div className="flex h-9 w-6 justify-center rounded-full border border-white/50 bg-white/[0.12] pt-1.5 backdrop-blur-sm">
            <span className="animate-scroll-dot h-2 w-1 rounded-full bg-[#5CFF5C]" />
          </div>
        </div>

        {/* =================================================
            TRANSICIÓN FINAL EN DOS ETAPAS
            ================================================= */}

        {/* Video hacia verde institucional */}

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 z-30 bg-[#004700]"
          style={{
            opacity:
              greenTransitionOpacity,
          }}
        />

        {/* Verde institucional hacia contenido claro */}

        <div
          aria-hidden="true"
          className="pointer-events-none absolute inset-0 z-40 bg-[#F4F7F5]"
          style={{
            opacity:
              lightTransitionOpacity,
          }}
        />
      </div>
    </section>
  );
}